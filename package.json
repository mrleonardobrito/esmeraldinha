{
  "name": "esmeraldinha",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:data-api": "tsx --env-file-if-exists=server/database/.env server/database/index.ts",
    "build:data-api": "node scripts/build-data-api.mjs",
    "start:data-api": "node --env-file-if-exists=server/database/.env dist-data-api/index.cjs",
    "db:provision": "tsx --env-file-if-exists=server/database/.env.operator scripts/provision-database.ts",
    "db:import-auth-journal": "tsx --env-file-if-exists=server/auth-admin/.env scripts/import-auth-journal.ts",
    "provision:auxiliar": "node --env-file-if-exists=server/auth-admin/.env scripts/provision-auxiliar.mjs",
    "dev:auth-admin": "tsx --env-file-if-exists=server/auth-admin/.env server/auth-admin/index.ts",
    "build:auth-admin": "node scripts/build-auth-admin.mjs",
    "start:auth-admin": "node --env-file-if-exists=server/auth-admin/.env dist-auth-admin/index.cjs",
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=server/.env server/index.ts",
    "dev:electron": "concurrently -n vite,electron -c cyan,green \"pnpm dev:web\" \"pnpm electron:watch\"",
    "electron:watch": "node electron/build.mjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --ozone-platform=x11",
    "start:api": "tsx --env-file-if-exists=.env --env-file-if-exists=server/.env server/index.ts",
    "build": "tsc -b && vite build",
    "build:electron": "node electron/build.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "playwright:install": "playwright install chromium",
    "dist": "pnpm build && pnpm build:electron && electron-builder",
    "dist:win": "pnpm build && pnpm build:electron && electron-builder --win",
    "dist:linux": "pnpm build && pnpm build:electron && electron-builder --linux"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e965/xlsx": "^0.20.3",
    "@hono/node-server": "^2.1.8",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "2.119.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^9.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "playwright": "^1.62.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-joyride": "^3.2.0",
    "react-router": "^8.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.11.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.4.0",
    "ioredis-mock": "^8.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.3.0"
}
