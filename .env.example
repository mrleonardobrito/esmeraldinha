# Este arquivo é a base. server/.env, se existir, sobrescreve o que estiver aqui.
# URL do portal do professor usado pelas cadernetas.
PORTAL_URL=https://educacao.cloud.el.com.br/al-limoeirodeanadia-pm-edu/paginas/portalProfessor/index.xhtml

# Porta da API local (o Vite faz proxy de /api para cá).
SERVER_PORT=3001

# Use false para acompanhar o navegador durante o scraping.
PORTAL_HEADLESS=true

# Tempo de ociosidade até a sessão do portal ser encerrada (ms).
PORTAL_SESSION_IDLE_MS=900000

# Onde salvar screenshot + HTML quando o login falha.
PORTAL_DEBUG_DIR=.portal-debug
