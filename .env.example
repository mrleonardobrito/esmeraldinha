# Este arquivo é a base. server/.env, se existir, sobrescreve o que estiver aqui.
# URL do portal do professor usado pelas cadernetas.
PORTAL_URL=https://educacao.cloud.el.com.br/al-limoeirodeanadia-pm-edu/paginas/portalProfessor/index.xhtml

# Porta da API local (o Vite faz proxy de /api para cá).
SERVER_PORT=3001

# Headless por funcionalidade: use false para acompanhar o navegador.
LOGIN_HEADLESS=true

# Tempo de ociosidade até a sessão do portal ser encerrada (ms).
PORTAL_SESSION_IDLE_MS=900000

# Redis onde os metadados da sessão do portal (id, professor, login, escola)
# ficam guardados com o mesmo prazo de vida acima. Sem Redis disponível a
# sessão continua funcionando só em memória — o Redis é cache auxiliar, não
# a fonte da verdade. Padrão: redis://localhost:6379
REDIS_URL=

# Fora de produção, os metadados da sessão ficam num Redis em memória
# (ioredis-mock) em vez de precisar de um servidor de verdade — não requer
# REDIS_URL. Force REDIS_EM_MEMORIA=false para testar contra um Redis real
# mesmo em dev, ou =true para usar o de memória mesmo com NODE_ENV=production.
REDIS_EM_MEMORIA=

# Onde salvar screenshot + HTML quando o login falha.
PORTAL_DEBUG_DIR=.portal-debug

# Chave da API do OpenRouter (https://openrouter.ai/keys), usada para ler o
# plano de aulas enviado nas cadernetas.
OPENROUTER_API_KEY=

# Modelo usado para ler o documento. Precisa aceitar imagem e PDF.
# Padrão: google/gemini-2.5-flash
OPENROUTER_MODEL=

# Base da API do OpenRouter. Padrão: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Tamanho máximo de cada arquivo de um envio, em bytes. Padrão: 10 MB.
MAX_UPLOAD_BYTES=

# Cifra as senhas do portal gravadas no SQLite. Gere com: openssl rand -base64 32
# Obrigatória fora do Electron (pnpm dev:api, testes); dentro do app empacotado
# a chave vem do keychain do sistema operacional via safeStorage.
ESMERALDINHA_ENCRYPTION_KEY=

# Força o adapter de encriptação: electron | dev. Vazio = detecta sozinho.
# Os testes usam `dev` para nunca tocar o keychain.
ENCRYPTION_ADAPTER=

# Sincronização semanal das cadernetas de madrugada (true para ligar).
# Ela loga no portal sozinha, então só funciona com o app aberto e, no Linux,
# com o keyring da sessão destravado — confira antes de confiar nela.
SYNC_SEMANAL=
# Dia da semana (0 = domingo). Padrão: 0.
SYNC_SEMANAL_DIA=
# Hora local (0-23). Padrão: 3.
SYNC_SEMANAL_HORA=

# Caminho do arquivo SQLite. Padrão: ./data/esmeraldinha.db
ESMERALDINHA_DB_PATH=
