# Este arquivo é a base. server/.env, se existir, sobrescreve o que estiver aqui.
# URL do portal do professor usado pelas cadernetas.
PORTAL_URL=https://educacao.cloud.el.com.br/al-limoeirodeanadia-pm-edu/paginas/portalProfessor/index.xhtml

# Porta da API local (o Vite faz proxy de /api para cá).
SERVER_PORT=3001

# Headless por funcionalidade: use false para acompanhar o navegador.
LOGIN_HEADLESS=true

# Tempo de ociosidade até a sessão do portal ser encerrada (ms).
PORTAL_SESSION_IDLE_MS=900000

# Onde salvar screenshot + HTML quando o login falha.
PORTAL_DEBUG_DIR=.portal-debug

# Chave da API do OpenRouter (https://openrouter.ai/keys), usada para ler o
# plano de aulas enviado nas cadernetas.
OPENROUTER_API_KEY=

# Modelo usado para ler o documento. Precisa aceitar imagens.
# Padrão: google/gemini-2.5-flash
OPENROUTER_MODEL=

# Cifra as senhas do portal gravadas no SQLite. Gere com: openssl rand -base64 32
# Obrigatória fora do Electron (pnpm dev:api, testes); dentro do app empacotado
# a chave vem do keychain do sistema operacional via safeStorage.
ESMERALDINHA_ENCRYPTION_KEY=

# Força o adapter de encriptação: electron | dev. Vazio = detecta sozinho.
# Os testes usam `dev` para nunca tocar o keychain.
ENCRYPTION_ADAPTER=

# Caminho do arquivo SQLite. Padrão: ./data/esmeraldinha.db
ESMERALDINHA_DB_PATH=
