# Controlled server only. Never copy this configuration into an Electron build.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_AUXILIAR_AUTH_ID=
# Needed only by the one-time provision:auxiliar command.
SUPABASE_AUXILIAR_EMAIL=
# Stable random key of at least 32 characters for operation fingerprints.
AUTH_ADMIN_JOURNAL_KEY=
# Persist and back up this database; run exactly one administration process.
AUTH_ADMIN_DB_PATH=./data/auth-admin.db
# Postgres mode: use the dedicated administration login, not the data API login.
AUTH_ADMIN_DATABASE_URL=
DATABASE_CA_PATH=
AUTH_ADMIN_PORT=3002
